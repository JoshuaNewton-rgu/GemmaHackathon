# Server
PORT=4000
NODE_ENV=development
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGIN=http://localhost:8081

# Database
MONGODB_URI=mongodb://localhost:27017/proofstudy

# Gemma 4 provider: "gemini_api" (hosted) or "self_hosted" (Ollama/vLLM OpenAI-compatible endpoint)
GEMMA_PROVIDER=gemini_api
GEMMA_MODEL=gemma-4-31b-it
# GEMMA_MODEL=gemma-4-26b-a4b-it  # lighter/faster MoE variant

# Required when GEMMA_PROVIDER=gemini_api (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Required when GEMMA_PROVIDER=self_hosted, e.g. `ollama serve` or a vLLM OpenAI-compatible server
SELF_HOSTED_GEMMA_URL=http://localhost:11434

# TTS provider: "device" (free, on-device, default) or "elevenlabs" (real persona voices)
TTS_PROVIDER=device
ELEVENLABS_API_KEY=
