# Heid Doon configuration. Copy to .env and fill in.
# Real environment variables always win over this file.

# Where the weights run: google | openai_compat | ollama | mock
HEIDDOON_PROVIDER=google

# The model handle AS THE BACKEND NAMES IT. These differ per backend for the same
# weights, so don't guess — run `python -m heiddoon doctor`, which prints every
# handle your key can actually reach.
HEIDDOON_MODEL=

# Hosted backends. Also read from GOOGLE_API_KEY if GEMMA_API_KEY is unset.
GEMMA_API_KEY=

# openai_compat only: a full base URL, or one of
# openrouter | together | groq | fireworks
HEIDDOON_BASE_URL=

# Local backend.
HEIDDOON_OLLAMA_HOST=http://localhost:11434
HEIDDOON_OLLAMA_MODEL=gemma4:12b

# Seconds between check-ins. A rhythm of check-ins, not millisecond policing —
# and an honest budget for local inference. Raise it if `doctor` warns you.
HEIDDOON_CADENCE_S=20

HEIDDOON_DB=./heiddoon.db
HEIDDOON_TIMEOUT_S=180
