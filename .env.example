# Heid Doon configuration. Copy to .env and fill in.
# Real environment variables always win over this file.

# Where the weights run: google | openai_compat | ollama | mock
HEIDDOON_PROVIDER=google

# The model handle AS THE BACKEND NAMES IT. These differ per backend for the same
# weights, so don't guess — run `python -m heiddoon doctor`, which prints every
# handle your key can actually reach.
HEIDDOON_MODEL=

# Hosted backends. Also read from GOOGLE_API_KEY if GEMMA_API_KEY is unset.
GEMMA_API_KEY=

# openai_compat only: a full base URL, or one of
# openrouter | together | groq | fireworks
HEIDDOON_BASE_URL=

# Local backend.
HEIDDOON_OLLAMA_HOST=http://localhost:11434
HEIDDOON_OLLAMA_MODEL=gemma4:12b

# Seconds between check-ins for the CLI watcher. A rhythm of check-ins, not
# millisecond policing — and an honest budget for local inference.
HEIDDOON_CADENCE_S=20

# Seconds between automatic screen checks in the web app. Longer than the CLI
# default on purpose: every changed screen is a vision call, and an hour at 20s is
# 180 of them. Unchanged screens are skipped and cost nothing.
# For a live demo, set this to 5 — or use the Pace control on the Watch screen,
# which changes it without a restart. Note that a verdict itself takes ~16s and
# cannot be hurried (thinking is not optional on Gemma 4), so a low cadence makes
# *detection* fast, not the verdict.
HEIDDOON_AUTO_CADENCE_S=60

# Minutes between "show me your page" prompts, for handwritten notes. 0 turns them
# off. It only ever asks when nothing else has proved you are working — if you are
# typing into a tracked file, you are never asked.
# Minutes between automatic progress checks on writing read off the screen. Each is
# a text call, and someone typing changes the screen constantly, so this is the
# throttle that makes always-on affordable. Set 0 for a demo to check every cycle.
HEIDDOON_PROGRESS_EVERY_MIN=5

HEIDDOON_NOTES_PROMPT_EVERY_MIN=25

# Have the model phrase each nudge. Set 0 and the model-free line is used instead —
# it quotes your own stated reason back at you, which is what the prompt asks the
# model to do anyway. Measured on this backend: phrasing costs 20-77s, because
# Gemma 4 reasons before answering and the thinking budget cannot be set to zero.
# A drift verdict goes from ~35-112s to ~14s with this off. Recommended for a demo.
HEIDDOON_WRITE_NUDGE=1

# Grade break answers by key-point overlap instead of asking the model. Same path
# used when the model is unreachable, so it is a supported way to grade rather than
# a fake one — what is lost is warm, specific feedback, not the pass or fail.
# Grading goes from ~35s to instant. Recommended for a demo.
HEIDDOON_FAST_GRADE=0

HEIDDOON_DB=./heiddoon.db
HEIDDOON_TIMEOUT_S=180
